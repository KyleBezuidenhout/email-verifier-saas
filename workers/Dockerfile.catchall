FROM python:3.11-slim

WORKDIR /app

# Copy worker requirements and install (minimal, faster builds)
COPY workers/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend app directory (needed for imports)
COPY backend/app ./app

# Copy catchall worker script + shared utilities
COPY workers/catchall_worker.py .
COPY workers/email_utils.py .

# Run the catchall worker
CMD ["python3", "catchall_worker.py"]
